rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdminEmail() {
      return isSignedIn() && 
             request.auth.token.email != null &&
             (request.auth.token.email == 'm.ngwako63@gmail.com' ||
              request.auth.token.email == 'M.ngwako63@gmail.com' ||
              request.auth.token.email == 'admin@mojadiacademy.com');
    }
    
    function isAdmin() {
      return isSignedIn() && (
        isAdminEmail() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && (
        incoming().role == 'student' || 
        incoming().role == 'user' || 
        (incoming().role == 'admin' && isAdminEmail())
      ) && (
        incoming().studentId.matches('^STU-[0-9]{4}-[0-9]{6}$') ||
        incoming().studentId.matches('^ADMIN-[0-9]{4}$')
      );

      allow update: if isAdminEmail() || isAdmin() || (isOwner(userId) && (
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'createdAt']) &&
        (!incoming().diff(existing()).affectedKeys().hasAny(['studentId']) || !('studentId' in existing()))
      ));
      
      // Enrollments subcollection
      match /enrollments/{courseId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAdmin() || (isOwner(userId) && (
          incoming().accessStatus == 'active' || 
          incoming().accessStatus == 'locked' || 
          !incoming().keys().hasAny(['accessStatus'])
        ));
        allow update: if isAdmin() || (isOwner(userId) && !incoming().diff(existing()).affectedKeys().hasAny(['accessStatus']));
      }
    }

    // Course Overrides
    match /course_overrides/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid)) || isAdmin();
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid) && (incoming().status == 'pending');
      allow update: if isAdmin() || (isOwner(resource.data.userId) && (
        (incoming().status == 'paid' && existing().status == 'pending') ||
        (incoming().status == 'pending' && existing().status == 'paid')
      ) && incoming().diff(existing()).affectedKeys().hasOnly(['status']));
    }

    // Payment Receipts
    match /payment_receipts/{receiptId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid)) || isAdmin();
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isOwner(existing().userId) && existing().status == 'pending');
    }

    // Courses
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isAdmin();

        match /lessons/{lessonId} {
          allow read: if true; 
          allow write: if isAdmin();
        }
      }
    }

    // Assessments
    match /assessments/{assessmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Certificates
    match /certificates/{certificateId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid);
    }

    // Media Assets
    match /media_assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
