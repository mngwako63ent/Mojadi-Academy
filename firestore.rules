rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdminEmail() {
      return isSignedIn() && 
             request.auth.token.email != null &&
             (request.auth.token.email == 'm.ngwako63@gmail.com' ||
              request.auth.token.email == 'M.ngwako63@gmail.com' ||
              request.auth.token.email == 'admin@mojadiacademy.com');
    }
    
    function isAdmin() {
      return isSignedIn() && (
        isAdminEmail() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && (
        incoming().role == 'student' || 
        (incoming().role == 'admin' && isAdminEmail())
      ) && (
        incoming().studentId.matches('^STU-[0-9]{4}-[0-9]{6}$') ||
        incoming().studentId.matches('^ADMIN-[0-9]{4}$')
      );

      allow update: if isAdminEmail() || isAdmin() || (isOwner(userId) && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'studentId', 'createdAt']));
      
      // Enrollments subcollection
      match /enrollments/{courseId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAdmin() || (isOwner(userId) && (!incoming().keys().hasAny(['accessStatus']) || incoming().accessStatus == 'locked'));
        allow update: if isAdmin() || (isOwner(userId) && !incoming().diff(existing()).affectedKeys().hasAny(['accessStatus']));
      }
    }

    // Orders
    match /orders/{orderId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid)) || isAdmin();
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid) && (incoming().status == 'pending');
      allow update: if isAdmin() || (isOwner(existing().userId) && incoming().status == 'paid' && existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['status']));
    }

    // Payment Receipts
    match /payment_receipts/{receiptId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid)) || isAdmin();
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
