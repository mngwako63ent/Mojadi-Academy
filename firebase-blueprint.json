{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user information and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "studentId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "studentId", "createdAt"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Stores user enrollment in a course.",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "accessStatus": { "type": "string", "enum": ["active", "locked"] },
        "completedModules": { "type": "array", "items": { "type": "string" } },
        "activatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Stores course purchase orders.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "studentId": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid", "activated"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "PaymentReceipt": {
      "title": "Payment Receipt",
      "description": "Stores proof of payment uploads.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "orderId": { "type": "string" },
        "receiptFile": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles."
    },
    "/users/{userId}/enrollments/{courseId}": {
      "schema": "Enrollment",
      "description": "User course enrollments."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Purchase orders."
    },
    "/payment_receipts/{receiptId}": {
      "schema": "PaymentReceipt",
      "description": "Payment receipts."
    }
  }
}
